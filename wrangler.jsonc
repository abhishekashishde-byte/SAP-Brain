{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sap-brain",
  "compatibility_date": "2026-11-19",
  // Needed by the Vercel-era handlers (Buffer, node:crypto, docx, pptxgenjs).
  // With this compat date, process.env is also populated from vars and secrets.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // API calls must always reach the Worker, never the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  // Per-IP request limits (checked in worker/api-routes.js). AI endpoints cost money,
  // so they get the tighter limit.
  "ratelimits": [
    { "name": "RL_AI", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
