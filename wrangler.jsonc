{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sap-brain",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "main": "worker/index.js",
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
