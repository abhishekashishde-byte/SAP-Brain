{
  "rewrites": [
    {
      "source": "/api/discovery-ai",
      "destination": "/api/discovery?route=ai"
    },
    {
      "source": "/api/discovery-import",
      "destination": "/api/discovery?route=import"
    },
    {
      "source": "/api/discovery-transcript",
      "destination": "/api/discovery?route=transcript"
    },
    {
      "source": "/api/discovery-retention",
      "destination": "/api/discovery?route=retention"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 300
    },
    "api/external-chat.js": {
      "maxDuration": 60
    },
    "api/extract.js": {
      "maxDuration": 15
    },
    "api/recall.js": {
      "maxDuration": 10
    },
    "api/categorise.js": {
      "maxDuration": 15
    },
    "api/summarise.js": {
      "maxDuration": 30
    },
    "api/reference-search.js": {
      "maxDuration": 300
    },
    "api/generate-fs-doc.js": {
      "maxDuration": 60
    },
    "api/generate-ppt.js": {
      "maxDuration": 60
    },
    "api/Notify.js": {
      "maxDuration": 30
    },
    "api/discovery.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/discovery-retention",
      "schedule": "0 3 * * *"
    }
  ]
}
